{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "contrast", "color": "#1d252c", "name": "Contrast" },
				{ "slug": "primary", "color": "#0046be", "name": "Primary" },
				{ "slug": "secondary", "color": "#ffb800", "name": "Secondary" },
				{ "slug": "dark", "color": "#0e1b26", "name": "Dark" },
				{ "slug": "light-gray", "color": "#f5f5f5", "name": "Light Gray" },
				{ "slug": "border-gray", "color": "#d9d9d9", "name": "Border Gray" }
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "System",
					"slug": "system",
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.125rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.5rem", "name": "XL" }
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "2rem",
						"bottom": "0.75rem",
						"left": "2rem"
					}
				},
				"border": {
					"radius": "4px",
					"width": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.5px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--dark)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--dark)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			}
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "1.5rem",
				"bottom": "0",
				"left": "1.5rem"
			}
		},
		"typography": {
			"fontSize": "1rem",
			"fontFamily": "var(--wp--preset--font-family--system)",
			"lineHeight": "1.5"
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}