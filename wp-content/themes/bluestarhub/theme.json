{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0f172a",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#2563eb",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#38bdf8",
					"name": "Secondary"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1440px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "System (Roboto, Segoe UI, Ubuntu)",
					"slug": "system",
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)"
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"blocks": {
			"core/heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"core/paragraph": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"lineHeight": "1.7"
				}
			},
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "6px"
				}
			},
			"core/navigation": {
				"color": {
					"text": "var(--wp--preset--color--contrast)",
					"background": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontWeight": "500"
				}
			},
			"core/navigation-link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/site-title": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontWeight": "700"
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/post-title": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				},
				"border": {
					"color": "var(--wp--preset--color--secondary)",
					"style": "solid",
					"width": "1px"
				}
			},
			"core/pullquote": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"style": "solid",
					"width": "4px"
				},
				"typography": {
					"fontStyle": "italic"
				}
			},
			"core/quote": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"style": "solid",
					"width": "0 0 0 4px"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontFamily": "monospace"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "monospace"
				}
			},
			"core/table": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"color": "var(--wp--preset--color--secondary)",
					"style": "solid",
					"width": "1px"
				}
			},
			"core/search": {
				"color": {
					"text": "var(--wp--preset--color--contrast)",
					"background": "var(--wp--preset--color--base)"
				}
			},
			"core/tag-cloud": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/loginout": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		}
	}
}