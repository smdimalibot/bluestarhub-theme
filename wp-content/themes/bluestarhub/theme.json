{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",

	"settings": {
		"appearanceTools": true,

		"color": {
			"palette": [
				{ "slug": "dark-navy",   "color": "#001A3D", "name": "Dark Navy"   },
				{ "slug": "navy",        "color": "#003B8E", "name": "Navy"        },
				{ "slug": "yellow",      "color": "#FFD700", "name": "Yellow"      },
				{ "slug": "white",       "color": "#FFFFFF", "name": "White"       },
				{ "slug": "body-text",   "color": "#1A1A1A", "name": "Body Text"   },
				{ "slug": "caption",     "color": "#4A5568", "name": "Caption"     },
				{ "slug": "light-caption","color": "#B0C4DE","name": "Light Caption"},
				{ "slug": "page-bg",     "color": "#F4F4F4", "name": "Page BG"     },
				{ "slug": "card-bg",     "color": "#FFFFFF", "name": "Card BG"     },
				{ "slug": "section-bg",  "color": "#E8EEF7", "name": "Section BG"  },
				{ "slug": "input-bg",    "color": "#F9FAFB", "name": "Input BG"    },
				{ "slug": "border",      "color": "#D0D8E8", "name": "Border"      }
			],
			"gradients": [],
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false
		},

		"layout": {
			"contentSize": "1200px",
			"wideSize":    "1400px"
		},

		"spacing": {
			"spacingScale": {
				"steps":    7,
				"mediumStep": 16,
				"unit":     "px",
				"operator": "linear",
				"increment": 8
			},
			"spacingSizes": [
				{ "slug": "10", "size": "8px",  "name": "XS — 8px"   },
				{ "slug": "20", "size": "16px", "name": "SM — 16px"  },
				{ "slug": "30", "size": "24px", "name": "MD — 24px"  },
				{ "slug": "40", "size": "32px", "name": "LG — 32px"  },
				{ "slug": "50", "size": "40px", "name": "XL — 40px"  },
				{ "slug": "60", "size": "56px", "name": "2XL — 56px" },
				{ "slug": "70", "size": "80px", "name": "3XL — 80px" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},

		"typography": {
			"dropCap": false,
			"fluid": false,
			"customFontSize": true,

			"fontFamilies": [
				{
					"name": "System Sans-Serif",
					"slug": "system",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],

			"fontSizes": [
				{ "slug": "xs",      "size": "12px", "name": "XS — 12px"       },
				{ "slug": "small",   "size": "14px", "name": "Small — 14px"    },
				{ "slug": "medium",  "size": "16px", "name": "Medium — 16px"   },
				{ "slug": "large",   "size": "18px", "name": "Large — 18px"    },
				{ "slug": "xl",      "size": "22px", "name": "XL — 22px"       },
				{ "slug": "2xl",     "size": "28px", "name": "2XL — 28px"      },
				{ "slug": "3xl",     "size": "36px", "name": "3XL — 36px"      },
				{ "slug": "4xl",     "size": "48px", "name": "4XL — 48px"      }
			]
		},

		"useRootPaddingAwareAlignments": true,

		"blocks": {
			"core/image": {
				"color": { "custom": true }
			},
			"core/button": {
				"color": { "custom": true }
			},
			"woocommerce/cart": {
				"color": { "custom": true }
			},
			"woocommerce/checkout": {
				"color": { "custom": true }
			}
		},

		"custom": {
			"border": {
				"default":       "1px solid #D0D8E8",
				"focus":         "1.5px solid #FFD700",
				"input":         "1px solid #003B8E",
				"radius":        "4px"
			},
			"spacing": {
				"section-y":     "40px",
				"card-padding":  "20px",
				"form-padding":  "30px"
			}
		}
	},

	"styles": {

		"color": {
			"background": "var(--wp--preset--color--page-bg)",
			"text":       "var(--wp--preset--color--body-text)"
		},

		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize":   "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},

		"spacing": {
			"padding": {
				"top":    "0px",
				"right":  "var(--wp--style--root--padding-right)",
				"bottom": "0px",
				"left":   "var(--wp--style--root--padding-left)"
			}
		},

		"elements": {

			"link": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--yellow)" },
					"typography": { "textDecoration": "underline" }
				}
			},

			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text":       "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"fontFamily": "var(--wp--preset--font-family--system)",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top":    "12px",
						"right":  "24px",
						"bottom": "12px",
						"left":   "24px"
					}
				},
				"border": {
					"radius": "4px",
					"width":  "0px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--yellow)",
						"text":       "var(--wp--preset--color--dark-navy)"
					}
				},
				":focus": {
					"outline": {
						"color":  "var(--wp--preset--color--yellow)",
						"width":  "2px",
						"offset": "2px"
					}
				}
			},

			"h1": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--4xl)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"fontFamily": "var(--wp--preset--font-family--system)"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"h2": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--3xl)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"fontFamily": "var(--wp--preset--font-family--system)"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"h3": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--2xl)",
					"fontWeight": "600",
					"lineHeight": "1.25",
					"fontFamily": "var(--wp--preset--font-family--system)"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"h4": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--xl)",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"fontFamily": "var(--wp--preset--font-family--system)"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"h5": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"fontFamily": "var(--wp--preset--font-family--system)"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"h6": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"fontFamily": "var(--wp--preset--font-family--system)"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			}
		},

		"blocks": {

			"core/paragraph": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.6"
				},
				"color": { "text": "var(--wp--preset--color--body-text)" }
			},

			"core/group": {
				"spacing": {
					"padding": {
						"top":    "40px",
						"right":  "24px",
						"bottom": "40px",
						"left":   "24px"
					}
				}
			},

			"core/columns": {
				"spacing": {
					"blockGap": "24px",
					"margin": {
						"top":    "0px",
						"bottom": "0px"
					}
				}
			},

			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" },
				"border": {
					"color": "var(--wp--preset--color--border)",
					"width": "1px"
				}
			},

			"core/image": {
				"border": { "radius": "4px" }
			},

			"core/cover": {
				"color": {
					"background": "var(--wp--preset--color--dark-navy)",
					"text":       "var(--wp--preset--color--white)"
				},
				"spacing": {
					"padding": {
						"top":    "80px",
						"right":  "24px",
						"bottom": "80px",
						"left":   "24px"
					}
				}
			},

			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--navy)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"color":  { "text": "var(--wp--preset--color--body-text)" },
				"spacing": {
					"padding": {
						"top":    "16px",
						"right":  "24px",
						"bottom": "16px",
						"left":   "24px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic"
				}
			},

			"core/list": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.8"
				},
				"color": { "text": "var(--wp--preset--color--body-text)" }
			},

			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text":       "var(--wp--preset--color--body-text)",
					"background": "var(--wp--preset--color--card-bg)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"width": "1px",
					"style": "solid"
				}
			},

			"core/search": {
				"border": {
					"radius": "4px",
					"width":  "1px",
					"color":  "var(--wp--preset--color--border)"
				},
				"color": {
					"background": "var(--wp--preset--color--input-bg)",
					"text":       "var(--wp--preset--color--body-text)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},

			"core/navigation": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"color": {
					"text":       "var(--wp--preset--color--white)",
					"background": "transparent"
				}
			},

			"core/navigation-link": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"color": { "text": "var(--wp--preset--color--white)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--yellow)" }
				}
			},

			"core/site-title": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--xl)",
					"fontWeight": "700",
					"lineHeight": "1"
				},
				"color": { "text": "var(--wp--preset--color--white)" }
			},

			"core/site-tagline": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": { "text": "var(--wp--preset--color--light-caption)" }
			},

			"core/post-title": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--4xl)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": { "text": "var(--wp--preset--color--caption)" }
			},

			"core/post-author": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": { "text": "var(--wp--preset--color--caption)" }
			},

			"core/post-excerpt": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.6"
				},
				"color": { "text": "var(--wp--preset--color--body-text)" }
			},

			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xs)"
				},
				"color": { "text": "var(--wp--preset--color--navy)" }
			},

			"core/comments-title": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--xl)",
					"fontWeight": "600"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"core/comment-author-name": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"core/comment-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xs)"
				},
				"color": { "text": "var(--wp--preset--color--caption)" }
			},

			"core/query-pagination": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"color": { "text": "var(--wp--preset--color--navy)" }
			},

			"core/query-pagination-numbers": {
				"color": { "text": "var(--wp--preset--color--navy)" }
			},

			"woocommerce/product-title": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"woocommerce/product-price": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--medium)",
					"fontWeight": "700"
				},
				"color": { "text": "var(--wp--preset--color--body-text)" }
			},

			"woocommerce/add-to-cart-button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text":       "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--small)",
					"fontWeight": "700"
				},
				"border":  { "radius": "4px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--yellow)",
						"text":       "var(--wp--preset--color--dark-navy)"
					}
				}
			},

			"woocommerce/cart-order-summary-heading": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--xl)",
					"fontWeight": "700"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"woocommerce/proceed-to-checkout-block": {
				"color": {
					"background": "var(--wp--preset--color--yellow)",
					"text":       "var(--wp--preset--color--dark-navy)"
				},
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--medium)",
					"fontWeight": "700"
				},
				"border": { "radius": "4px" }
			},

			"woocommerce/checkout-order-summary-heading": {
				"typography": {
					"fontSize":   "var(--wp--preset--font-size--xl)",
					"fontWeight": "700"
				},
				"color": { "text": "var(--wp--preset--color--dark-navy)" }
			},

			"woocommerce/featured-product": {
				"color": {
					"background": "var(--wp--preset--color--dark-navy)",
					"text":       "var(--wp--preset--color--white)"
				}
			}
		}
	},

	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],

	"customTemplates": [
		{
			"name":      "full-width",
			"title":     "Full Width",
			"postTypes": [ "page", "post" ]
		},
		{
			"name":      "no-sidebar",
			"title":     "No Sidebar",
			"postTypes": [ "page", "post" ]
		},
		{
			"name":      "woocommerce-cart",
			"title":     "WooCommerce Cart",
			"postTypes": [ "page" ]
		},
		{
			"name":      "woocommerce-checkout",
			"title":     "WooCommerce Checkout",
			"postTypes": [ "page" ]
		},
		{
			"name":      "woocommerce-my-account",
			"title":     "WooCommerce My Account",
			"postTypes": [ "page" ]
		},
		{
			"name":      "woocommerce-shop",
			"title":     "WooCommerce Shop",
			"postTypes": [ "page" ]
		}
	]
}