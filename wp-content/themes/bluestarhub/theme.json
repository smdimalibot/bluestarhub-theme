{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "base", "color": "#f1f5f9", "name": "Base" },
				{ "slug": "contrast", "color": "#1e293b", "name": "Contrast" },
				{ "slug": "primary", "color": "#3b82f6", "name": "Primary" },
				{ "slug": "secondary", "color": "#06b6d4", "name": "Secondary" },
				{ "slug": "dark-navy", "color": "#0f172a", "name": "Dark Navy" },
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "slate-gray", "color": "#475569", "name": "Slate Gray" },
				{ "slug": "muted-gray", "color": "#64748b", "name": "Muted Gray" },
				{ "slug": "transparent", "color": "transparent", "name": "Transparent" }
			]
		},
		"layout": {
			"contentSize": "750px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "System",
					"slug": "system",
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/navigation": {
				"color": {
					"background": "var(--wp--preset--color--dark-navy)"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem"
					}
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--white)"
						},
						"typography": {
							"textDecoration": "none",
							"fontWeight": "600"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--secondary)"
							}
						}
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				"border": {
					"radius": "999px",
					"width": "0px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "700"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		},
		"spacing": {
			"padding": {
				"right": "var(--wp--preset--spacing--50)",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontSize": "1.125rem",
			"fontFamily": "var(--wp--preset--font-family--system)",
			"lineHeight": "1.7"
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{
			"name": "no-title",
			"title": "No title",
			"postTypes": [ "post", "page" ]
		}
	]
}